{
  "rules": {
    "anime": {
      ".read": true
    },
    "animevietsub": {
      ".read": true
    },
    "users": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },
    "room": {
      ".read": true,
      "$roomId": {
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
        "chat": {
          "$msgId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['uid', 'name', 'text', 'ts']) && newData.child('text').isString() && newData.child('text').val().length <= 500"
          }
        }
      }
    }
  }
}
